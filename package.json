{
  "name": "topic-pages",
  "version": "1.0.0",
  "description": "주제별 정적 문서 사이트 빌더. site.json + content/*.md → 정적 멀티페이지 문서 사이트.",
  "license": "MIT",
  "type": "module",
  "main": "scripts/build.mjs",
  "exports": {
    ".": "./scripts/build.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "topic-pages": "./bin/topic-pages.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "playwright test"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "marked": "^18.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "lib",
    "assets",
    "scripts",
    "bin",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpaceTravelCompany/topic-pages.git"
  },
  "bugs": {
    "url": "https://github.com/SpaceTravelCompany/topic-pages/issues"
  },
  "homepage": "https://github.com/SpaceTravelCompany/topic-pages#readme",
  "keywords": [
    "static-site",
    "documentation",
    "markdown",
    "spa",
    "vulkan",
    "graphics"
  ],
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
